@22334  = ~Aiiiiee! Have mercy! Have mercy!~
@22335  = ~Oh, er, yes... of course!~
@22336  = ~Dum-de-dum-de-dum. Oh... have we met?~
@22337  = ~Galvarey~
@22338  = ~Galvarey~
@22339  = ~Oh, pardon me, friend... I think you dropped something here...~
